# ─────────────────────────────────────────────────────────────────────────────
# AgentHub — copier en `.env` puis remplir. Ne jamais committer le `.env`.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Accès à l'interface -------------------------------------------------------
# Mot de passe unique demandé à la connexion.
AGENTHUB_PASSWORD=change-moi

# Clé de signature des cookies de session. Génère-la, ne la choisis pas :
#   openssl rand -hex 32
AGENTHUB_SECRET=change-moi-aussi

# Fournisseurs de modèles ---------------------------------------------------
# Ces variables ne servent qu'à AMORCER la base au tout premier démarrage.
# Ensuite, tout se configure depuis l'interface (Réglages → Fournisseurs),
# et c'est la base qui fait foi.
#
# Laisse vide ce que tu n'utilises pas : l'assistant de configuration
# s'ouvrira au premier accès pour brancher un service.

# Gateway Nous Hermes Agent (facultatif)
HERMES_API_URL=http://hermes-agent:8642
HERMES_GATEWAY_API_KEY=
HERMES_MODEL=hermes-agent

# AgentRouter (facultatif)
AGENTROUTER_API_URL=
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=

# Fournisseur utilisé par les agents qui n'en précisent pas.
AGENTHUB_DEFAULT_PROVIDER=hermes

# Déploiement ---------------------------------------------------------------
# Domaine servi par Traefik : l'app répondra sur agenthub.<TRAEFIK_HOST>.
# Inutile si tu n'utilises pas Traefik.
TRAEFIK_HOST=exemple.com
